    "check:publication": "bundle exec ruby scripts/test_jekyll_source_state.rb",
    "check:documentation": "bundle exec ruby scripts/test_documentation.rb",
    "images:responsive": "python scripts/generate-responsive-images.py",
    "images:webp": "python scripts/generate-tracked-webp.py",
    "images:social": "node scripts/generate-social-images.mjs",
    "check:importador": "node --check importador/reconstruct-wxr.mjs && node --check importador/media-recovery.mjs && npm run import:wxr:dry && npm run import:media:plan -- --limit=5",
    "check": "npm run check:ts && npm run check:html && npm run check:footnotes && npm run check:math && npm run check:assets && npm run check:authors && npm run check:namespaces && npm run check:quotes && npm run check:accessibility && npm run check:accessible-runtime && npm run check:inline-quotes && npm run check:print && npm run check:performance && npm run check:social-images && npm run check:editorial-assets && npm run check:covers && npm run check:attributions && npm run check:publication && npm run check:documentation",
