    "check:quotes": "bundle exec ruby scripts/test_quote_semantics.rb",
    "check:accessibility": "bundle exec ruby scripts/test_accessible_reading.rb",
    "check:accessible-runtime": "node scripts/test_accessible_runtime.mjs",
